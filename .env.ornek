# Bu dosyanın kopyasını .env adıyla oluşturup değerleri doldurun.
# .env .gitignore'da, depoya gitmez. Bu şablon dosyası gider.

# Varsayılan admin hesabının şifresi.
# Tanımlı değilse admin hesabı hiç oluşturulmaz.
ADMIN_PASSWORD=

# Gemini API anahtarı. Streamlit tarafı .streamlit/secrets.toml içinden de okur.
GEMINI_API_KEY=
